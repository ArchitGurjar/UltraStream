<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/stream_addon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HdHub"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue" />

        <TextView
            android:id="@+id/stream_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4KHDHub 4K"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="#22ffffff"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp"
            android:radius="6dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/stream_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[Server] [ ] Speak No Evil (2024)..."
        android:textSize="14sp"
        android:textColor="@color/text_main"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- Badges Container will be populated dynamically via Kotlin using exact CSS colors -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/stream_chip_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

</LinearLayout>
